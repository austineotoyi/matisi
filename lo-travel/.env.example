## LO Travel Platform — Environment Variables
##
## Copy this file to .env and fill in the values.
## Never commit .env to git.
##
## All variables prefixed with EXPO_PUBLIC_ are bundled into the
## client app at build time and are visible to users.

## ─── App Environment ─────────────────────────────────────────────────────────

# Environment: "development" | "staging" | "production"
EXPO_PUBLIC_ENV=development

## ─── API Configuration ───────────────────────────────────────────────────────

# Base URL of the LO Travel backend API
# Development: http://localhost:8080
# Production:  https://api.lotravel.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

## ─── Flight APIs (Phase 2 — not yet connected) ───────────────────────────────

# Amadeus (https://developers.amadeus.com)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Duffel (https://duffel.com/docs)
DUFFEL_ACCESS_TOKEN=

# Sabre (https://developer.sabre.com)
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=

## ─── Hotel / Tour APIs (Phase 2 — not yet connected) ─────────────────────────

BOOKING_COM_API_KEY=
VIATOR_API_KEY=

## ─── Payment Gateway (Phase 2 — not yet connected) ──────────────────────────

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

## ─── Push Notifications (Phase 2 — not yet connected) ────────────────────────

EXPO_PUBLIC_PUSH_PROJECT_ID=
